---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/project/ProjectCard.astro';
import SiteLinks from '../components/layout/SiteLinks.astro';

const allProjects = await getCollection('projects');

function periodToNum(p?: string) {
  if (!p) return 0;
  const m = p.match(/(\d{4})\.(\d{2})(?:\.(\d{2}))?/);
  return m ? parseInt(m[1]) * 10000 + parseInt(m[2]) * 100 + (m[3] ? parseInt(m[3]) : 0) : 0;
}
const sortedProjects = [...allProjects].sort(
  (a, b) => periodToNum(b.data.period) - periodToNum(a.data.period)
);

const TOPIC_ORDER = ['Claude·Agent', '데이터·대시보드', '의사결정·리서치', '개발·엔지니어링'];
const projByCat = new Map<string, typeof sortedProjects>();
for (const pr of sortedProjects) {
  const c = pr.data.category;
  if (!projByCat.has(c)) projByCat.set(c, []);
  projByCat.get(c)!.push(pr);
}
const projCats = [
  ...TOPIC_ORDER.filter(c => projByCat.has(c)),
  ...[...projByCat.keys()].filter(c => !TOPIC_ORDER.includes(c)),
];
---

<style>
  .home-wrap {
    width: 100%;
    max-width: 60rem;
    margin: 0 auto;
    padding: 2.5rem 2rem;
    box-sizing: border-box;
  }
  .intro {
    margin-bottom: 2.5rem;
  }
  .intro h1 {
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 0.75rem;
    letter-spacing: -0.01em;
  }
  .intro p {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.8;
    max-width: 42rem;
  }
  .section-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 1rem;
  }
  .home-section {
    margin-bottom: 2.75rem;
  }
  .all-link {
    display: inline-block;
    margin-top: 1.5rem;
    font-size: 0.875rem;
    color: var(--text-tertiary);
  }

  @media (max-width: 768px) {
    .home-wrap { padding: 1.75rem 1.25rem; }
  }
</style>

<BaseLayout title="조성덕 — sungduk">
  <div class="home-wrap">
    <section class="intro">
      <h1>조성덕</h1>
      <p>
        직접 쓸 도구를 만들면서 일합니다. 만든 것들을 네 주제로 묶어 아래에 정리했습니다 —
        Claude·Agent, 데이터·대시보드, 의사결정·리서치, 개발·엔지니어링. 글은 writing 에,
        이력서는 resume 에 따로 있습니다.
      </p>
    </section>

    <section class="home-section">
      <h2 class="section-label">Elsewhere</h2>
      <SiteLinks current="home" />
    </section>

    <section class="home-section">
      <h2 class="section-label">Projects</h2>
      <div class="topics">
        {projCats.map(cat => (
          <div class="topic">
            <h3 class="topic-label">{cat} <span class="topic-count">{projByCat.get(cat)!.length}</span></h3>
            <div class="card-grid">
              {projByCat.get(cat)!.map(project => (
                <ProjectCard
                  title={project.data.title}
                  slug={project.id}
                  description={project.data.description}
                  period={project.data.period}
                  icon={project.data.icon}
                  category={project.data.category}
                  variant="card"
                />
              ))}
            </div>
          </div>
        ))}
      </div>
      <a href="/projects" class="all-link">All →</a>
    </section>
  </div>
</BaseLayout>
