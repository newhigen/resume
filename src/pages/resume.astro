---
const dest = 'https://resume.sungd.uk/';
---

<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="refresh" content={`0; url=${dest}`} />
  <link rel="canonical" href={dest} />
  <title>이력서 — resume.sungd.uk로 이동</title>
</head>
<body>
  <p>이력서 페이지가 <a href={dest}>resume.sungd.uk</a>로 옮겨갔습니다.</p>
  <script is:inline define:vars={{ dest }}>
    location.replace(dest);
  </script>
</body>
</html>
